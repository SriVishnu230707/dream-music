{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mood-drift:candidate-request:1",
  "title": "Phase 3 candidate request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "strategy", "limit"],
  "properties": {
    "userId": {"type": "string", "minLength": 1, "maxLength": 128},
    "strategy": {"enum": ["popularity", "taste", "taste-explore"]},
    "limit": {"type": "integer", "minimum": 1, "maximum": 20},
    "preferredGenres": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "likedTrackIds": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "excludeTrackIds": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "events": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["eventId", "trackId", "type"],
        "properties": {
          "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
          "trackId": {"type": "string", "minLength": 1},
          "type": {"enum": ["start", "skip", "complete", "replay", "like"]},
          "listenedSeconds": {"type": "number", "minimum": 0, "maximum": 3600}
        }
      }
    },
    "popularityCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}
