{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mood-drift:catalog:1",
  "title": "Mood Drift demo catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "description", "tracks"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "catalogId": {"const": "generated-demo-v1"},
    "description": {"type": "string", "minLength": 1},
    "tracks": {"type": "array", "minItems": 8, "items": {"$ref": "urn:mood-drift:track:1"}}
  }
}
